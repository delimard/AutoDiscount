<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="autodiscount.configure" path="/admin/module/AutoDiscount" methods="GET">
        <default key="_controller">AutoDiscount\Controller\AutoDiscountConfigController::configureAction</default>
    </route>

    <route id="autodiscount.save" path="/admin/module/AutoDiscount/save" methods="POST">
        <default key="_controller">AutoDiscount\Controller\AutoDiscountConfigController::saveAction</default>
    </route>

</routes>
